rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Otorisasi dasar Minggu 10: hanya pengguna yang sudah login
    // yang boleh membaca dan menulis data aplikasi Es Teh.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
